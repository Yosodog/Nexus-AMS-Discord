{
  "name": "nexus-ams-discord-bot",
  "version": "0.1.0",
  "description": "Discord bot for Nexus AMS.",
  "type": "module",
  "main": "src/bot.js",
  "scripts": {
    "start": "node src/bot.js",
    "register": "node src/registerCommands.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-lines=60 --test-coverage-branches=45 --test-coverage-functions=60 test/*.test.js",
    "lint": "find src test -name '*.js' -print0 | xargs -0 -n1 node --check",
    "check": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.17.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2"
  }
}
