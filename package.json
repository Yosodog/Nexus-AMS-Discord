{
  "name": "nexus-ams-discord-bot",
  "version": "0.1.0",
  "description": "Discord bot for Nexus AMS.",
  "type": "module",
  "main": "src/bot.js",
  "scripts": {
    "healthcheck": "node src/healthcheck.js",
    "start": "node src/bot.js",
    "register": "node src/registerCommands.js",
    "keygen:relay": "node src/generateRelayKey.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='src/**/*.js' --test-coverage-exclude='test/**' --test-coverage-lines=80 --test-coverage-branches=65 --test-coverage-functions=80 test/*.test.js",
    "lint": "find src test -name '*.js' -print0 | xargs -0 -n1 node --check",
    "check": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "axios": "^1.18.1",
    "discord.js": "^14.26.5",
    "dotenv": "^17.4.2"
  },
  "overrides": {
    "form-data": "4.0.6",
    "undici": "6.28.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}
