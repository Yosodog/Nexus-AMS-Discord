{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.nexus.example/discord/relay-proof-v2.schema.json",
  "title": "Nexus Discord relay proof v2",
  "description": "A signed, replay-bounded proof for one Discord relay request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "connection_id",
    "app_id",
    "guild_id",
    "generation",
    "key_id",
    "issued_at",
    "expires_at",
    "idempotency_key",
    "proof",
    "route",
    "body_sha256",
    "signature"
  ],
  "properties": {
    "contract": { "const": "relay-proof" },
    "contract_version": { "const": 2 },
    "connection_id": { "$ref": "#/definitions/uuid" },
    "app_id": { "$ref": "#/definitions/snowflake" },
    "guild_id": { "$ref": "#/definitions/snowflake" },
    "generation": { "$ref": "#/definitions/generation" },
    "key_id": { "$ref": "#/definitions/keyId" },
    "issued_at": { "$ref": "#/definitions/utcDateTime" },
    "expires_at": { "$ref": "#/definitions/utcDateTime" },
    "idempotency_key": { "$ref": "#/definitions/uuid" },
    "proof": { "$ref": "#/definitions/proof" },
    "route": { "$ref": "#/definitions/route" },
    "body_sha256": { "$ref": "#/definitions/sha256" },
    "signature": { "$ref": "#/definitions/signature" }
  },
  "definitions": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "snowflake": {
      "type": "string",
      "pattern": "^[0-9]{17,20}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "utcDateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 2,
      "maxLength": 256,
      "pattern": "^/[A-Za-z0-9._~:/{}-]{1,255}$"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": {
          "enum": ["DELETE", "GET", "PATCH", "POST", "PUT"]
        },
        "path": { "$ref": "#/definitions/path" }
      }
    },
    "proof": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "interaction_id", "user_id", "command"],
          "properties": {
            "type": { "const": "interaction" },
            "interaction_id": { "$ref": "#/definitions/snowflake" },
            "user_id": { "$ref": "#/definitions/snowflake" },
            "command": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-z][a-z0-9._-]{0,99}$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "action", "nonce"],
          "properties": {
            "type": { "const": "service" },
            "action": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[a-z][a-z0-9._:-]{0,99}$"
            },
            "nonce": { "$ref": "#/definitions/uuid" }
          }
        }
      ]
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "value": {
          "type": "string",
          "minLength": 128,
          "maxLength": 128,
          "pattern": "^[a-f0-9]{128}$"
        }
      }
    }
  }
}
