{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.nexus.example/discord/route-endorsement-v1.schema.json",
  "title": "Nexus Discord route endorsement v1",
  "description": "A signed, time-bounded endorsement of one manifest route for one relay binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "issuer",
    "audience",
    "key_scope",
    "endorsement_id",
    "manifest_id",
    "connection_id",
    "app_id",
    "guild_id",
    "generation",
    "key_id",
    "issued_at",
    "expires_at",
    "idempotency_key",
    "route_id",
    "route_template",
    "capability",
    "effect",
    "signature"
  ],
  "properties": {
    "contract": { "const": "route-endorsement" },
    "contract_version": { "const": 1 },
    "issuer": { "const": "nexus" },
    "audience": { "const": "discord-relay" },
    "key_scope": { "const": "nexus->discord-relay" },
    "endorsement_id": { "$ref": "#/definitions/uuid" },
    "manifest_id": { "$ref": "#/definitions/uuid" },
    "connection_id": { "$ref": "#/definitions/uuid" },
    "app_id": { "$ref": "#/definitions/snowflake" },
    "guild_id": { "$ref": "#/definitions/snowflake" },
    "generation": { "$ref": "#/definitions/generation" },
    "key_id": { "$ref": "#/definitions/keyId" },
    "issued_at": { "$ref": "#/definitions/utcDateTime" },
    "expires_at": { "$ref": "#/definitions/utcDateTime" },
    "idempotency_key": { "$ref": "#/definitions/uuid" },
    "route_id": { "$ref": "#/definitions/routeId" },
    "route_template": { "$ref": "#/definitions/routeTemplate" },
    "capability": { "$ref": "#/definitions/capability" },
    "effect": { "const": "allow" },
    "signature": { "$ref": "#/definitions/signature" }
  },
  "definitions": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "snowflake": {
      "type": "string",
      "pattern": "^[0-9]{17,20}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "utcDateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "routeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._:-]{0,127}$"
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9._:-]{0,63}$"
    },
    "templatePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 256,
      "pattern": "^/[A-Za-z0-9._~:/{}-]{1,255}$"
    },
    "routeTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path_template"],
      "properties": {
        "method": {
          "enum": ["DELETE", "GET", "PATCH", "POST", "PUT"]
        },
        "path_template": { "$ref": "#/definitions/templatePath" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "value": {
          "type": "string",
          "minLength": 128,
          "maxLength": 128,
          "pattern": "^[a-f0-9]{128}$"
        }
      }
    }
  }
}
