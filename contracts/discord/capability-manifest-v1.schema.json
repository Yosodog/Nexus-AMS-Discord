{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.nexus.example/discord/capability-manifest-v1.schema.json",
  "title": "Nexus Discord capability manifest v1",
  "description": "A signed directional capability manifest with an issuer-owned key set.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "issuer",
    "audience",
    "key_scope",
    "manifest_id",
    "connection_id",
    "app_id",
    "guild_id",
    "generation",
    "key_id",
    "issued_at",
    "expires_at",
    "key_set",
    "limits",
    "signature"
  ],
  "properties": {
    "contract": { "const": "capability-manifest" },
    "contract_version": { "const": 1 },
    "issuer": {
      "enum": ["discord-relay", "nexus"]
    },
    "audience": {
      "enum": ["discord-relay", "nexus"]
    },
    "key_scope": {
      "enum": ["discord-relay->nexus", "nexus->discord-relay"]
    },
    "manifest_id": { "$ref": "#/definitions/uuid" },
    "connection_id": { "$ref": "#/definitions/uuid" },
    "app_id": { "$ref": "#/definitions/snowflake" },
    "guild_id": { "$ref": "#/definitions/snowflake" },
    "generation": { "$ref": "#/definitions/generation" },
    "key_id": { "$ref": "#/definitions/keyId" },
    "issued_at": { "$ref": "#/definitions/utcDateTime" },
    "expires_at": { "$ref": "#/definitions/utcDateTime" },
    "key_set": { "$ref": "#/definitions/keySet" },
    "http_routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/definitions/routeTemplate" }
    },
    "supported_queue_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/action" }
    },
    "renderers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/definitions/renderer" }
    },
    "limits": { "$ref": "#/definitions/limits" },
    "signature": { "$ref": "#/definitions/signature" }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "required": ["issuer", "audience", "key_scope", "supported_queue_actions", "renderers"],
          "properties": {
            "issuer": { "const": "discord-relay" },
            "audience": { "const": "nexus" },
            "key_scope": { "const": "discord-relay->nexus" },
            "key_set": {
              "allOf": [
                { "$ref": "#/definitions/keySet" },
                {
                  "type": "object",
                  "properties": {
                    "owner": { "const": "discord-relay" },
                    "scope": { "const": "discord-relay->nexus" }
                  }
                }
              ]
            },
            "supported_queue_actions": { "$ref": "#/properties/supported_queue_actions" },
            "renderers": { "$ref": "#/properties/renderers" }
          },
          "not": {
            "anyOf": [
              { "type": "object", "required": ["http_routes"], "properties": { "http_routes": {} } }
            ]
          }
        },
        {
          "required": ["issuer", "audience", "key_scope", "http_routes"],
          "properties": {
            "issuer": { "const": "nexus" },
            "audience": { "const": "discord-relay" },
            "key_scope": { "const": "nexus->discord-relay" },
            "key_set": {
              "allOf": [
                { "$ref": "#/definitions/keySet" },
                {
                  "type": "object",
                  "properties": {
                    "owner": { "const": "nexus" },
                    "scope": { "const": "nexus->discord-relay" }
                  }
                }
              ]
            },
            "http_routes": { "$ref": "#/properties/http_routes" }
          },
          "not": {
            "anyOf": [
              { "type": "object", "required": ["supported_queue_actions"], "properties": { "supported_queue_actions": {} } },
              { "type": "object", "required": ["renderers"], "properties": { "renderers": {} } }
            ]
          }
        }
      ]
    }
  ],
  "definitions": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "snowflake": {
      "type": "string",
      "pattern": "^[0-9]{17,20}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "utcDateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "routeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._:-]{0,127}$"
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9._:-]{0,63}$"
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
    },
    "templatePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 256,
      "pattern": "^/[A-Za-z0-9._~:/{}-]{1,255}$"
    },
    "routeTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "method", "path_template", "capability"],
      "properties": {
        "route_id": { "$ref": "#/definitions/routeId" },
        "method": {
          "enum": ["DELETE", "GET", "PATCH", "POST", "PUT"]
        },
        "path_template": { "$ref": "#/definitions/templatePath" },
        "capability": { "$ref": "#/definitions/capability" }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer_id", "version", "max_payload_bytes"],
      "properties": {
        "renderer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_payload_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16384
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_batch_items",
        "max_delivery_bytes",
        "max_proof_bytes",
        "max_receipt_bytes",
        "max_clock_skew_seconds",
        "max_lease_seconds",
        "dedupe_window_seconds",
        "max_delivery_attempts"
      ],
      "properties": {
        "max_batch_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_delivery_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16384
        },
        "max_proof_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65536
        },
        "max_receipt_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 262144
        },
        "max_clock_skew_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "max_lease_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "dedupe_window_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "max_delivery_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "publicKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "public_key", "activated_at"],
      "properties": {
        "key_id": { "$ref": "#/definitions/keyId" },
        "algorithm": { "const": "ed25519" },
        "public_key": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "activated_at": { "$ref": "#/definitions/utcDateTime" }
      }
    },
    "nextPublicKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "public_key", "activates_at"],
      "properties": {
        "key_id": { "$ref": "#/definitions/keyId" },
        "algorithm": { "const": "ed25519" },
        "public_key": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "activates_at": { "$ref": "#/definitions/utcDateTime" }
      }
    },
    "keySet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "scope", "current", "next"],
      "properties": {
        "owner": {
          "enum": ["discord-relay", "nexus"]
        },
        "scope": {
          "enum": ["discord-relay->nexus", "nexus->discord-relay"]
        },
        "current": { "$ref": "#/definitions/publicKey" },
        "next": {
          "oneOf": [
            { "$ref": "#/definitions/nextPublicKey" },
            { "type": "null" }
          ]
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "value": {
          "type": "string",
          "minLength": 128,
          "maxLength": 128,
          "pattern": "^[a-f0-9]{128}$"
        }
      }
    }
  }
}
