{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.nexus.example/discord/capability-manifest-v1.schema.json",
  "title": "Nexus Discord capability manifest v1",
  "description": "The signed capabilities, routes, limits, and key set for one Discord relay binding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "contract_version",
    "manifest_id",
    "connection_id",
    "app_id",
    "guild_id",
    "generation",
    "key_id",
    "issued_at",
    "expires_at",
    "capabilities",
    "routes",
    "limits",
    "keys",
    "signature"
  ],
  "properties": {
    "contract": { "const": "capability-manifest" },
    "contract_version": { "const": 1 },
    "manifest_id": { "$ref": "#/definitions/uuid" },
    "connection_id": { "$ref": "#/definitions/uuid" },
    "app_id": { "$ref": "#/definitions/snowflake" },
    "guild_id": { "$ref": "#/definitions/snowflake" },
    "generation": { "$ref": "#/definitions/generation" },
    "key_id": { "$ref": "#/definitions/keyId" },
    "issued_at": { "$ref": "#/definitions/utcDateTime" },
    "expires_at": { "$ref": "#/definitions/utcDateTime" },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/capability" }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/definitions/route" }
    },
    "limits": { "$ref": "#/definitions/limits" },
    "keys": { "$ref": "#/definitions/keys" },
    "signature": { "$ref": "#/definitions/signature" }
  },
  "definitions": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "snowflake": {
      "type": "string",
      "pattern": "^[0-9]{17,20}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "utcDateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9._:-]{0,63}$"
    },
    "routeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._:-]{0,127}$"
    },
    "path": {
      "type": "string",
      "minLength": 2,
      "maxLength": 256,
      "pattern": "^/[A-Za-z0-9._~:/{}-]{1,255}$"
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "method", "path", "capability"],
      "properties": {
        "route_id": { "$ref": "#/definitions/routeId" },
        "method": {
          "enum": ["DELETE", "GET", "PATCH", "POST", "PUT"]
        },
        "path": { "$ref": "#/definitions/path" },
        "capability": { "$ref": "#/definitions/capability" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_batch_items",
        "max_delivery_bytes",
        "max_proof_bytes",
        "max_receipt_bytes",
        "max_clock_skew_seconds",
        "max_lease_seconds",
        "dedupe_window_seconds"
      ],
      "properties": {
        "max_batch_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "max_delivery_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16384
        },
        "max_proof_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65536
        },
        "max_receipt_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 262144
        },
        "max_clock_skew_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "max_lease_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        },
        "dedupe_window_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        }
      }
    },
    "publicKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "public_key", "activated_at"],
      "properties": {
        "key_id": { "$ref": "#/definitions/keyId" },
        "algorithm": { "const": "ed25519" },
        "public_key": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "activated_at": { "$ref": "#/definitions/utcDateTime" }
      }
    },
    "nextPublicKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "public_key", "activates_at"],
      "properties": {
        "key_id": { "$ref": "#/definitions/keyId" },
        "algorithm": { "const": "ed25519" },
        "public_key": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "activates_at": { "$ref": "#/definitions/utcDateTime" }
      }
    },
    "keys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "next"],
      "properties": {
        "current": { "$ref": "#/definitions/publicKey" },
        "next": {
          "oneOf": [
            { "$ref": "#/definitions/nextPublicKey" },
            { "type": "null" }
          ]
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "value": {
          "type": "string",
          "minLength": 128,
          "maxLength": 128,
          "pattern": "^[a-f0-9]{128}$"
        }
      }
    }
  }
}
