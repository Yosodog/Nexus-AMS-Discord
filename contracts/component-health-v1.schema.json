{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.example/contracts/discord-component-health-v1.schema.json",
  "title": "Nexus Discord component health contract",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "contract_version",
    "component_id",
    "service",
    "status",
    "runtime_state",
    "health_state",
    "reachable",
    "installed",
    "enabled",
    "configuration_ready",
    "version",
    "release_id",
    "heartbeat_at",
    "build"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "contract_version": {"const": 1},
    "component_id": {"const": "nexus-discord"},
    "service": {"const": "nexus-ams-discord"},
    "status": {
      "enum": ["starting", "ready", "degraded", "stopping", "stopped", "failed"]
    },
    "runtime_state": {
      "enum": ["starting", "ready", "degraded", "stopping", "stopped", "failed"]
    },
    "health_state": {
      "enum": ["starting", "healthy", "degraded", "stopping", "stopped", "failed"]
    },
    "reachable": {"type": "boolean"},
    "installed": {"const": true},
    "enabled": {"type": "boolean"},
    "configuration_ready": {"type": "boolean"},
    "version": {"type": "string", "minLength": 1},
    "release_id": {"type": "string", "minLength": 1},
    "heartbeat_at": {"type": "string", "format": "date-time"},
    "build": {
      "type": "object",
      "required": ["version", "commit", "release"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1},
        "release": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
