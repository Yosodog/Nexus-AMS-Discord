# Runtime mode. Production enforces HTTPS for NEXUS_API_URL.
NODE_ENV=development
# DEBUG, INFO, WARN, or ERROR. Production defaults to INFO when omitted.
LOG_LEVEL=DEBUG

# Discord configuration. Client and guild values must be Discord snowflakes.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Nexus API configuration. HTTP is permitted only outside production.
NEXUS_API_URL=http://127.0.0.1:8000
NEXUS_API_KEY=
