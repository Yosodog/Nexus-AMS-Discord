# Runtime mode. Production enforces HTTPS for NEXUS_API_URL.
NODE_ENV=development
# DEBUG, INFO, WARN, or ERROR. Production defaults to INFO when omitted.
LOG_LEVEL=DEBUG

# dedicated (default) or official-shared.
BOT_DEPLOYMENT_MODE=dedicated

# Discord configuration. Client and guild values must be Discord snowflakes.
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Official-shared connection snapshots. The file is a complete JSON array and
# is re-read atomically; DISCORD_CONNECTIONS_JSON remains a static fallback.
DISCORD_CONNECTIONS_FILE=
DISCORD_CONNECTION_REFRESH_MS=30000
DISCORD_CONNECTIONS_JSON=[]

# Nexus API configuration. HTTP is permitted only outside production.
NEXUS_API_URL=http://127.0.0.1:8000
NEXUS_API_KEY=
# Base64-encoded PKCS#8 Ed25519 private key used only to sign Nexus relay proofs.
NEXUS_DISCORD_RELAY_PRIVATE_KEY=

# Local process readiness and immutable build metadata.
PROCESS_HEALTH_FILE=data/process-health.json
PROCESS_HEALTH_INTERVAL_MS=15000
PROCESS_HEALTH_STALE_AFTER_MS=45000
BUILD_COMMIT=unknown
NEXUS_RELEASE_ID=unknown
